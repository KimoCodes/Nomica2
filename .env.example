# NOMICA — Environment Variables
# Copy this file to .env and fill in real values.

# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nomica"

# ── NextAuth ──────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ── Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."

# ── Cloudinary (https://console.cloudinary.com/app/settings/api-keys)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ── Resend Email (https://resend.com/api-keys) — optional
# RESEND_API_KEY="re_..."
# EMAIL_FROM="NOMICA <noreply@nomica.com>"

# ── Server ────────────────────────────────────────────
# HOSTNAME="0.0.0.0"
# PORT="3000"

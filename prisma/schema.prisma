generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  CLIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  LOSE_FAT
  GAIN_MUSCLE
  GENERAL_FITNESS
  STRENGTH
}

enum ActivityLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  NONE
  DUMBBELLS
  HOME_GYM
  COMMERCIAL_GYM
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  GLUTES
  SHOULDERS
  ARMS
  CORE
  MOBILITY
  CARDIO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
}

enum SubscriptionPlan {
  ALL_ACCESS_MONTHLY
  ALL_ACCESS_ANNUAL
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROOF_REQUESTED
}

enum ProductKind {
  PROGRAM
  CHALLENGE
  BUNDLE
}

enum ProductFocus {
  SWEAT
  SCULPT
  CLIMB
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELED
}

enum PhotoView {
  FRONT
  SIDE
  BACK
}

enum MediaType {
  WORKOUT_VIDEO
  EXERCISE_DEMO
  TRAINING_IMAGE
  TRANSFORMATION
  PROGRESS_PHOTO
  PROGRESS_VIDEO
  HERO_REEL
  PRODUCT_IMAGE
  QUIZ_MEDIA
}

enum MediaVisibility {
  PUBLIC
  COACH_ONLY
  CLIENT_ONLY
  TEAM_ONLY
}

enum ProgressLogType {
  PROGRESS_PHOTO
  FORM_CHECK
  WEEKLY_UPDATE
  MEASUREMENT
  MILESTONE
  COACH_FEEDBACK
}

enum TransformationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_MESSAGE
  WORKOUT_ASSIGNED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REVOKED
  CHECK_IN_DUE
  COACH_ASSIGNED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_PROOF_REQUESTED
  FREE_TRIAL_GRANTED
  FREE_TRIAL_EXPIRING
  FREE_TRIAL_EXPIRED
  FREE_TRIAL_CANCELLED
  SESSION_BOOKED
  SESSION_CONFIRMED
  SESSION_CANCELLED
  SESSION_RESCHEDULED
  SESSION_REMINDER
  SESSION_COMPLETED
  EXERCISE_PLAN_ASSIGNED
  NUTRITION_PLAN_ASSIGNED
  PLAN_UPDATED
  PLAN_PROGRESS_UPDATE
}

enum SessionStatus {
  PENDING
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  CANCELLED
  COMPLETED
  MISSED
}

enum SessionType {
  CONSULTATION
  TRAINING
  ASSESSMENT
  FOLLOW_UP
  CUSTOM
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum FreeTrialStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CLIENT)
  avatar        String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coachProfile            CoachProfile?
  clientProfile           ClientProfile?
  subscription            Subscription?
  approvedSubscriptions   Subscription[]           @relation("ApprovedBy")
  paymentRequests         PaymentRequest[]         @relation("PaymentRequestClient")
  coachedPaymentRequests  PaymentRequest[]         @relation("PaymentRequestCoach")
  reviewedPaymentRequests PaymentRequest[]         @relation("PaymentRequestReviewer")
  auditLogs               PaymentRequestAuditLog[] @relation("AuditLogPerformer")
  notifications           Notification[]
  sentMessages            Message[]
  clientConversations     Conversation[]           @relation("ClientConversations")
  coachConversations      Conversation[]           @relation("CoachConversations")
  coachedClients          ClientProfile[]          @relation("ClientCoach")
  checkInResponses        CheckInResponse[]
  uploadedMedia           Media[]
  coachedProgressLogs     ProgressLog[]
  purchases               Purchase[]
  reviews                 Review[]
  habits                  Habit[]
  aiConversations         AiConversation[]
  goals                   Goal[]
  favorites               Favorite[]
  freeTrials              FreeTrial[]              @relation("FreeTrialRecipient")
  grantedFreeTrials       FreeTrial[]              @relation("FreeTrialGrantor")
  pageVisits              PageVisit[]
  activityLogs            ActivityLog[]
  uploadedWebsiteMedia    WebsiteMedia[]
  createdPageContents     PageContent[]
  uploadedBrandAssets     BrandAsset[]
  createdSiteThemes       SiteTheme[]
  createdContentVersions  ContentVersion[]

  @@index([email])
  @@index([role])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model CoachProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  specialties        String[]
  yearsExperience    Int?
  certification      String?
  approved           Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  programs       Program[]
  bookings       CoachBooking[]
  exercisePlans  PersonalizedExercisePlan[]
  nutritionPlans PersonalizedNutritionPlan[]

  @@index([userId])
  @@index([approved])
}

model ClientProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  gender             Gender?
  height             Float?
  weight             Float?
  fitnessGoal        FitnessGoal?
  activityLevel      ActivityLevel?
  equipment          Equipment?
  coachId            String?
  coach              User?          @relation("ClientCoach", fields: [coachId], references: [id], onDelete: SetNull)
  onboardingComplete Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  programs           ClientProgram[]
  progressLogs       ProgressLog[]
  checkIns           CheckIn[]
  workoutCompletions WorkoutCompletion[]
  transformations    TransformationSubmission[]
  mealLogs           MealLog[]
  videoFeedback      VideoFeedback[]
  bookings           CoachBooking[]
  exercisePlans      PersonalizedExercisePlan[]
  nutritionPlans     PersonalizedNutritionPlan[]
  planProgress       PlanProgress[]

  @@index([userId])
  @@index([coachId])
}

model Program {
  id          String       @id @default(cuid())
  title       String
  description String?
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  isTemplate  Boolean      @default(false)
  isSellable  Boolean      @default(false)
  price       Int?
  imageUrl    String?
  features    String[]
  difficulty  Difficulty?
  duration    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  weeks       ProgramWeek[]
  assignments ClientProgram[]
  media       Media[]
  product     Product?

  @@index([coachId])
  @@index([isSellable])
}

/// A purchasable catalog item (source of truth: NOMICA_Fitness_Catalog.pdf).
/// PROGRAM/CHALLENGE products point at the Program that holds their workout
/// content; BUNDLE products reference their children through BundleItem.
model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  kind           ProductKind
  name           String
  tagline        String?
  description    String?       @db.Text
  priceCents     Int
  compareAtCents Int?
  durationLabel  String
  durationWeeks  Int?
  durationDays   Int?
  daysPerWeek    Int?
  focus          ProductFocus?
  features       String[]
  imageUrl       String?
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  programId String?  @unique
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  bundleItems BundleItem[] @relation("BundleParent")
  includedIn  BundleItem[] @relation("BundleChild")
  purchases   Purchase[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive, sortOrder])
}

model BundleItem {
  id       String  @id @default(cuid())
  bundleId String
  bundle   Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  itemId   String
  item     Product @relation("BundleChild", fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([bundleId, itemId])
  @@index([itemId])
}

/// One-time purchase of a Product. Entitlements are derived from COMPLETED
/// purchases (never stored directly) — see server/services/entitlement.service.ts.
model Purchase {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status            PurchaseStatus @default(PENDING)
  amountCents       Int
  currency          String         @default("usd")
  provider          String         @default("dev")
  providerSessionId String?        @unique
  providerPaymentId String?        @unique
  completedAt       DateTime?
  refundedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([productId, status])
}

model Review {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating      Int
  title       String?
  body        String  @db.Text
  isVerified  Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isPublished])
}

model ProgramWeek {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days  ProgramDay[]
  media Media[]

  @@unique([programId, weekNumber])
  @@index([programId])
}

model ProgramDay {
  id        String      @id @default(cuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber Int
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  exercises   ProgramExercise[]
  completions WorkoutCompletion[]
  media       Media[]

  @@unique([weekId, dayNumber])
  @@index([weekId])
}

model Exercise {
  id           String      @id @default(cuid())
  name         String
  muscleGroup  MuscleGroup
  difficulty   Difficulty
  instructions String      @db.Text
  videoUrl     String?
  coachId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  programExercises  ProgramExercise[]
  personalizedItems PersonalizedExerciseItem[]

  @@index([muscleGroup])
  @@index([coachId])
}

model ProgramExercise {
  id          String     @id @default(cuid())
  dayId       String
  day         ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order       Int
  sets        Int?
  reps        Int?
  duration    Int?
  restSeconds Int?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  setLogs WorkoutSetLog[]

  @@unique([dayId, order])
  @@index([dayId])
  @@index([exerciseId])
}

model ClientProgram {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  programId       String
  program         Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  startDate       DateTime      @default(now())
  endDate         DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  completions WorkoutCompletion[]

  @@index([clientProfileId])
  @@index([programId])
  @@index([isActive])
}

model WorkoutCompletion {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  programDayId    String
  programDay      ProgramDay    @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  clientProgramId String
  clientProgram   ClientProgram @relation(fields: [clientProgramId], references: [id], onDelete: Cascade)
  completedAt     DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  setLogs WorkoutSetLog[]

  @@index([clientProfileId])
  @@index([programDayId])
  @@index([clientProgramId])
  @@index([completedAt])
}

model WorkoutSetLog {
  id                  String            @id @default(cuid())
  workoutCompletionId String
  workoutCompletion   WorkoutCompletion @relation(fields: [workoutCompletionId], references: [id], onDelete: Cascade)
  programExerciseId   String
  programExercise     ProgramExercise   @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  setNumber           Int
  actualReps          Int?
  actualWeight        Float?
  completed           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([workoutCompletionId, programExerciseId, setNumber])
  @@index([workoutCompletionId])
  @@index([programExerciseId])
}

model Conversation {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachConversations", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([clientId, coachId])
  @@index([clientId])
  @@index([coachId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model CheckIn {
  id                String        @id @default(cuid())
  clientProfileId   String
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  weekStart         DateTime
  workoutsCompleted Int?
  energyLevel       Int?
  sleepQuality      Int?
  currentWeight     Float?
  submittedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  response CheckInResponse?

  @@index([clientProfileId])
  @@index([weekStart])
}

model CheckInResponse {
  id        String   @id @default(cuid())
  checkInId String   @unique
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  feedback  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
}

model ProgressLog {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  coachId         String?
  coach           User?         @relation(fields: [coachId], references: [id], onDelete: SetNull)

  type        ProgressLogType @default(PROGRESS_PHOTO)
  title       String?
  description String?

  weight  Float?
  bodyFat Float?
  waist   Float?
  chest   Float?
  hips    Float?
  hipCm   Float?
  gluteCm Float?
  thighCm Float?
  notes   String?

  mediaId String?
  media   Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  photos  ProgressPhoto[]

  coachComment String?
  coachRating  Int?
  commentedAt  DateTime?

  visibility MediaVisibility @default(COACH_ONLY)
  loggedAt   DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([clientProfileId])
  @@index([coachId])
  @@index([type])
  @@index([loggedAt])
}

model ProgressPhoto {
  id      String      @id @default(cuid())
  logId   String
  log     ProgressLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  view    PhotoView

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([logId, mediaId])
  @@index([logId])
  @@index([mediaId])
}

model TransformationSubmission {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  name  String
  quote String @db.Text
  story String @db.Text

  beforePhotoId String?
  beforePhoto   Media?  @relation("TransformationBefore", fields: [beforePhotoId], references: [id], onDelete: SetNull)
  afterPhotoId  String?
  afterPhoto    Media?  @relation("TransformationAfter", fields: [afterPhotoId], references: [id], onDelete: SetNull)

  beforeWeight Float?
  afterWeight  Float?
  duration     String?
  programName  String?

  status     TransformationStatus @default(SUBMITTED)
  coachNote  String?              @db.Text
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientProfileId])
  @@index([status])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(trialing)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  approvedById         String?
  approvedBy           User?              @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

model Payment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripePaymentId String       @unique
  amount          Int
  currency        String       @default("usd")
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([subscriptionId])
}

model BillingEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([stripeEventId])
  @@index([type])
  @@index([createdAt])
}

model PaymentRequest {
  id             String               @id @default(cuid())
  clientUserId   String
  clientUser     User                 @relation("PaymentRequestClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  coachUserId    String?
  coachUser      User?                @relation("PaymentRequestCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  plan           SubscriptionPlan
  amount         Int
  currency       String               @default("USD")
  paymentMethod  String
  transactionRef String?
  proofUrl       String
  proofFileName  String?
  notes          String?
  status         PaymentRequestStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?                @relation("PaymentRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  auditLogs PaymentRequestAuditLog[]

  @@index([clientUserId])
  @@index([coachUserId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRequestAuditLog {
  id               String         @id @default(cuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  action           String
  performedById    String
  performedBy      User           @relation("AuditLogPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  note             String?
  createdAt        DateTime       @default(now())

  @@index([paymentRequestId])
  @@index([performedById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Media {
  id           String    @id @default(cuid())
  title        String
  description  String?
  type         MediaType
  url          String
  thumbnailUrl String?
  fileSize     Int
  mimeType     String
  duration     Int?
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  programId    String?
  program      Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  weekId       String?
  week         ProgramWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)
  programDayId String?
  programDay   ProgramDay?  @relation(fields: [programDayId], references: [id], onDelete: SetNull)

  tags                  MediaTag[]
  progressLogs          ProgressLog[]
  progressPhotos        ProgressPhoto[]
  transformationsBefore TransformationSubmission[] @relation("TransformationBefore")
  transformationsAfter  TransformationSubmission[] @relation("TransformationAfter")

  visibility MediaVisibility @default(COACH_ONLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([uploadedById])
  @@index([programId])
}

model MediaTag {
  id      String @id @default(cuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     String

  @@unique([mediaId, tag])
  @@index([tag])
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("NOMICA")
  siteDescription String?  @default("Premium Feminine Transformation Fitness")
  contactEmail    String?
  contactPhone    String?
  address         String?
  logoUrl         String?
  faviconUrl      String?
  instagramUrl    String?
  tiktokUrl       String?
  youtubeUrl      String?
  twitterUrl      String?
  facebookUrl     String?
  heroTagline     String?  @default("Stop Scrolling. Start Sculpting.")
  heroSubtext     String?
  updatedAt       DateTime @updatedAt
}

model LandingContent {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String?
  subtitle  String?
  content   Json?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@index([order])
}

// ─── Admin Content Management ──────────────────────────────────────────────

enum WebsiteMediaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebsiteMediaCategory {
  HOMEPAGE
  WELCOME
  PROGRAMS
  BUNDLES
  SCULPT_CLUB
  PRICING
  ABOUT
  PROMOTIONAL
  BRANDING
  GENERAL
}

model WebsiteMedia {
  id           String               @id @default(cuid())
  name         String
  description  String?
  url          String
  thumbnailUrl String?
  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?
  duration     Float?
  altText      String?
  category     WebsiteMediaCategory @default(GENERAL)
  status       WebsiteMediaStatus   @default(DRAFT)
  version      Int                  @default(1)
  uploadedById String
  uploadedBy   User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  pageContents PageContent[]
  brandAssets  BrandAsset[]

  @@index([category])
  @@index([status])
  @@index([uploadedById])
  @@index([createdAt])
}

model PageContent {
  id          String             @id @default(cuid())
  pageSlug    String
  sectionKey  String
  title       String?
  subtitle    String?
  heading     String?
  description String?            @db.Text
  body        Json?
  mediaId     String?
  media       WebsiteMedia?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  ctaText     String?
  ctaLink     String?
  cta2Text    String?
  cta2Link    String?
  badge       String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  status      WebsiteMediaStatus @default(DRAFT)
  version     Int                @default(1)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([pageSlug, sectionKey])
  @@index([pageSlug])
  @@index([status])
  @@index([sortOrder])
}

model BrandAsset {
  id           String        @id @default(cuid())
  assetType    String
  name         String
  url          String
  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?
  mediaId      String?
  media        WebsiteMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([assetType])
  @@index([assetType])
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model SiteTheme {
  id          String    @id @default(cuid())
  name        String
  mode        ThemeMode @default(SYSTEM)
  isPublished Boolean   @default(false)

  primaryColor      String?
  primaryForeground String?
  secondaryColor    String?
  accentColor       String?
  destructiveColor  String?
  successColor      String?
  warningColor      String?

  backgroundColor String?
  foregroundColor String?
  cardColor       String?
  mutedColor      String?
  mutedFgColor    String?
  borderColor     String?

  headingFont  String?
  bodyFont     String?
  baseFontSize String?
  borderRadius String?

  customTokens Json?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model ContentVersion {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  version       Int
  title         String?
  subtitle      String?
  heading       String?
  description   String?  @db.Text
  body          Json?
  mediaUrl      String?
  ctaText       String?
  ctaLink       String?
  cta2Text      String?
  cta2Link      String?
  badge         String?
  themeSnapshot Json?
  snapshot      Json?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum HabitType {
  WATER
  SLEEP
  PROTEIN
  STRETCHING
  STEPS
  VITAMINS
}

model Habit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      HabitType
  target    Int       @default(1)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  logs HabitLog[]

  @@unique([userId, type])
  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Goal {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String
  targetValue  Float?
  currentValue Float?
  unit         String?
  status       GoalStatus @default(ACTIVE)
  deadline     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

enum FavoriteType {
  EXERCISE
  PROGRAM
  RECIPE
  ARTICLE
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FavoriteType
  targetId  String
  createdAt DateTime     @default(now())

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([type])
}

model FreeTrial {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("FreeTrialRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedById  String
  grantedBy    User            @relation("FreeTrialGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  durationDays Int
  startDate    DateTime        @default(now())
  endDate      DateTime
  status       FreeTrialStatus @default(ACTIVE)
  reason       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([grantedById])
  @@index([status])
  @@index([endDate])
}

model EarlyAccessSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Analytics ───────────────────────────────────────────────────────

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

model PageVisit {
  id         String     @id @default(cuid())
  path       String
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  deviceType DeviceType @default(UNKNOWN)
  browser    String?
  os         String?
  country    String?
  durationMs Int?
  createdAt  DateTime   @default(now())

  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  category     String?
  resourceType String?
  resourceId   String?
  description  String?
  metadata     Json?
  success      Boolean  @default(true)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([category, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model MealLog {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  loggedAt        DateTime      @default(now())
  mealType        MealType      @default(OTHER)
  notes           String?
  createdAt       DateTime      @default(now())

  items MealLogItem[]

  @@index([clientProfileId])
  @@index([loggedAt])
}

model MealLogItem {
  id           String   @id @default(cuid())
  mealLogId    String
  mealLog      MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  foodId       String
  foodName     String
  portionGrams Int
  calories     Int
  protein      Float
  carbs        Float
  fat          Float
  createdAt    DateTime @default(now())

  @@index([mealLogId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

model AiConversation {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage      String
  assistantMessage String
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model VideoFeedback {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  videoUrl        String
  exerciseName    String
  notes           String?
  status          String        @default("pending")
  coachNotes      String?
  formScore       Int?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientProfileId])
  @@index([status])
  @@index([createdAt])
}

model CoachBooking {
  id                  String         @id @default(cuid())
  clientProfileId     String
  clientProfile       ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  coachProfileId      String
  coachProfile        CoachProfile   @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  scheduledAt         DateTime
  durationMinutes     Int            @default(60)
  status              SessionStatus  @default(PENDING)
  sessionType         SessionType    @default(CONSULTATION)
  notes               String?
  cancellationReason  String?
  rescheduleOfId      String?
  rescheduleOf        CoachBooking?  @relation("RescheduledFrom", fields: [rescheduleOfId], references: [id], onDelete: SetNull)
  rescheduledBookings CoachBooking[] @relation("RescheduledFrom")
  rescheduleReason    String?
  meetingUrl          String?
  location            String?
  createdBy           String?
  coachNotes          String?
  clientConfirmed     Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  exercisePlans  PersonalizedExercisePlan[]
  nutritionPlans PersonalizedNutritionPlan[]

  @@index([clientProfileId])
  @@index([coachProfileId])
  @@index([scheduledAt])
  @@index([status])
  @@index([clientProfileId, status])
  @@index([coachProfileId, status])
}

// ─── Personalized Plans ───────────────────────────────────────────────────────

model PersonalizedExercisePlan {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         CoachBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  name        String
  description String?    @db.Text
  goal        String?
  status      PlanStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?

  weeklySchedule Json?
  coachNotes     String? @db.Text
  clientNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises PersonalizedExerciseItem[]
  progress  PlanProgress[]

  @@index([clientProfileId])
  @@index([coachProfileId])
  @@index([status])
  @@index([clientProfileId, status])
}

model PersonalizedExerciseItem {
  id                 String                   @id @default(cuid())
  personalizedPlanId String
  personalizedPlan   PersonalizedExercisePlan @relation(fields: [personalizedPlanId], references: [id], onDelete: Cascade)
  exerciseId         String?
  exercise           Exercise?                @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  name               String
  muscleGroup        MuscleGroup?
  dayOfWeek          Int?
  order              Int
  sets               Int?
  reps               Int?
  durationMinutes    Int?
  restSeconds        Int?
  intensity          String?
  instructions       String?                  @db.Text
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personalizedPlanId, dayOfWeek, order])
  @@index([personalizedPlanId])
  @@index([exerciseId])
}

model PersonalizedNutritionPlan {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         CoachBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  name        String
  description String?    @db.Text
  goal        String?
  status      PlanStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?

  dailyCalories Int?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  dailyWaterMl  Int?

  coachNotes  String? @db.Text
  clientNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals    PersonalizedMeal[]
  progress PlanProgress[]

  @@index([clientProfileId])
  @@index([coachProfileId])
  @@index([status])
  @@index([clientProfileId, status])
}

model PersonalizedMeal {
  id                 String                    @id @default(cuid())
  personalizedPlanId String
  personalizedPlan   PersonalizedNutritionPlan @relation(fields: [personalizedPlanId], references: [id], onDelete: Cascade)
  name               String
  mealType           MealType
  timeOfDay          String?
  order              Int
  foods              Json?
  instructions       String?                   @db.Text
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personalizedPlanId, mealType, order])
  @@index([personalizedPlanId])
}

model PlanProgress {
  id              String                     @id @default(cuid())
  exercisePlanId  String?
  exercisePlan    PersonalizedExercisePlan?  @relation(fields: [exercisePlanId], references: [id], onDelete: Cascade)
  nutritionPlanId String?
  nutritionPlan   PersonalizedNutritionPlan? @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)
  clientProfileId String
  clientProfile   ClientProfile              @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  date                 DateTime @default(now())
  completed            Boolean  @default(false)
  completionPercentage Float?
  setsCompleted        Int?
  repsCompleted        Int?
  durationMinutes      Int?
  adherenceScore       Float?
  notes                String?  @db.Text
  coachFeedback        String?  @db.Text

  createdAt DateTime @default(now())

  @@index([exercisePlanId])
  @@index([nutritionPlanId])
  @@index([clientProfileId])
  @@index([date])
}

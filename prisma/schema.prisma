generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  CLIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  LOSE_FAT
  GAIN_MUSCLE
  GENERAL_FITNESS
  STRENGTH
}

enum ActivityLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  NONE
  DUMBBELLS
  HOME_GYM
  COMMERCIAL_GYM
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  GLUTES
  SHOULDERS
  ARMS
  CORE
  MOBILITY
  CARDIO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
}

enum SubscriptionPlan {
  ALL_ACCESS_MONTHLY
  ALL_ACCESS_ANNUAL
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROOF_REQUESTED
}

enum ProductKind {
  PROGRAM
  CHALLENGE
  BUNDLE
}

enum ProductFocus {
  SWEAT
  SCULPT
  CLIMB
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELED
}

enum PhotoView {
  FRONT
  SIDE
  BACK
}

enum MediaType {
  WORKOUT_VIDEO
  EXERCISE_DEMO
  TRAINING_IMAGE
  TRANSFORMATION
  PROGRESS_PHOTO
  PROGRESS_VIDEO
  HERO_REEL
  PRODUCT_IMAGE
  QUIZ_MEDIA
}

enum MediaVisibility {
  PUBLIC
  COACH_ONLY
  CLIENT_ONLY
  TEAM_ONLY
}

enum ProgressLogType {
  PROGRESS_PHOTO
  FORM_CHECK
  WEEKLY_UPDATE
  MEASUREMENT
  MILESTONE
  COACH_FEEDBACK
}

enum NotificationType {
  NEW_MESSAGE
  WORKOUT_ASSIGNED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REVOKED
  CHECK_IN_DUE
  COACH_ASSIGNED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_PROOF_REQUESTED
  FREE_TRIAL_GRANTED
  FREE_TRIAL_EXPIRING
  FREE_TRIAL_EXPIRED
  FREE_TRIAL_CANCELLED
}

enum FreeTrialStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CLIENT)
  avatar        String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coachProfile          CoachProfile?
  clientProfile         ClientProfile?
  subscription          Subscription?
  approvedSubscriptions Subscription[] @relation("ApprovedBy")
  paymentRequests       PaymentRequest[] @relation("PaymentRequestClient")
  coachedPaymentRequests PaymentRequest[] @relation("PaymentRequestCoach")
  reviewedPaymentRequests PaymentRequest[] @relation("PaymentRequestReviewer")
  auditLogs             PaymentRequestAuditLog[] @relation("AuditLogPerformer")
  notifications       Notification[]
  sentMessages          Message[]
  clientConversations   Conversation[]    @relation("ClientConversations")
  coachConversations    Conversation[]    @relation("CoachConversations")
  coachedClients        ClientProfile[]   @relation("ClientCoach")
  checkInResponses      CheckInResponse[]
  uploadedMedia         Media[]
  coachedProgressLogs   ProgressLog[]
  purchases             Purchase[]
  reviews               Review[]
  habits                Habit[]
  goals                 Goal[]
  favorites             Favorite[]
  freeTrials            FreeTrial[] @relation("FreeTrialRecipient")
  grantedFreeTrials     FreeTrial[] @relation("FreeTrialGrantor")

  @@index([email])
  @@index([role])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model CoachProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  specialties        String[]
  yearsExperience    Int?
  certification      String?
  approved           Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  programs Program[]

  @@index([userId])
  @@index([approved])
}

model ClientProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  gender             Gender?
  height             Float?
  weight             Float?
  fitnessGoal        FitnessGoal?
  activityLevel      ActivityLevel?
  equipment          Equipment?
  coachId            String?
  coach              User?          @relation("ClientCoach", fields: [coachId], references: [id], onDelete: SetNull)
  onboardingComplete Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  programs           ClientProgram[]
  progressLogs       ProgressLog[]
  checkIns           CheckIn[]
  workoutCompletions WorkoutCompletion[]

  @@index([userId])
  @@index([coachId])
}

model Program {
  id          String       @id @default(cuid())
  title       String
  description String?
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  isTemplate  Boolean      @default(false)
  isSellable  Boolean      @default(false)
  price       Int?
  imageUrl    String?
  features    String[]
  difficulty  Difficulty?
  duration    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  weeks       ProgramWeek[]
  assignments ClientProgram[]
  media       Media[]
  product     Product?

  @@index([coachId])
  @@index([isSellable])
}

/// A purchasable catalog item (source of truth: NOMICA_Fitness_Catalog.pdf).
/// PROGRAM/CHALLENGE products point at the Program that holds their workout
/// content; BUNDLE products reference their children through BundleItem.
model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  kind           ProductKind
  name           String
  tagline        String?
  description    String?       @db.Text
  priceCents     Int
  compareAtCents Int?
  durationLabel  String
  durationWeeks  Int?
  durationDays   Int?
  daysPerWeek    Int?
  focus          ProductFocus?
  features       String[]
  imageUrl       String?
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  programId String?  @unique
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  bundleItems BundleItem[] @relation("BundleParent")
  includedIn  BundleItem[] @relation("BundleChild")
  purchases   Purchase[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive, sortOrder])
}

model BundleItem {
  id       String  @id @default(cuid())
  bundleId String
  bundle   Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  itemId   String
  item     Product @relation("BundleChild", fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([bundleId, itemId])
  @@index([itemId])
}

/// One-time purchase of a Product. Entitlements are derived from COMPLETED
/// purchases (never stored directly) — see server/services/entitlement.service.ts.
model Purchase {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status            PurchaseStatus @default(PENDING)
  amountCents       Int
  currency          String         @default("usd")
  provider          String         @default("dev")
  providerSessionId String?        @unique
  providerPaymentId String?        @unique
  completedAt       DateTime?
  refundedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([productId, status])
}

model Review {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating      Int
  title       String?
  body        String  @db.Text
  isVerified  Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isPublished])
}

model ProgramWeek {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days  ProgramDay[]
  media Media[]

  @@unique([programId, weekNumber])
  @@index([programId])
}

model ProgramDay {
  id        String      @id @default(cuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber Int
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  exercises   ProgramExercise[]
  completions WorkoutCompletion[]
  media       Media[]

  @@unique([weekId, dayNumber])
  @@index([weekId])
}

model Exercise {
  id           String      @id @default(cuid())
  name         String
  muscleGroup  MuscleGroup
  difficulty   Difficulty
  instructions String      @db.Text
  videoUrl     String?
  coachId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  programExercises ProgramExercise[]

  @@index([muscleGroup])
  @@index([coachId])
}

model ProgramExercise {
  id          String     @id @default(cuid())
  dayId       String
  day         ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order       Int
  sets        Int?
  reps        Int?
  duration    Int?
  restSeconds Int?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  setLogs WorkoutSetLog[]

  @@unique([dayId, order])
  @@index([dayId])
  @@index([exerciseId])
}

model ClientProgram {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  programId       String
  program         Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  startDate       DateTime      @default(now())
  endDate         DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  completions WorkoutCompletion[]

  @@index([clientProfileId])
  @@index([programId])
  @@index([isActive])
}

model WorkoutCompletion {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  programDayId    String
  programDay      ProgramDay    @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  clientProgramId String
  clientProgram   ClientProgram @relation(fields: [clientProgramId], references: [id], onDelete: Cascade)
  completedAt     DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  setLogs WorkoutSetLog[]

  @@index([clientProfileId])
  @@index([programDayId])
  @@index([clientProgramId])
}

model WorkoutSetLog {
  id                  String            @id @default(cuid())
  workoutCompletionId String
  workoutCompletion   WorkoutCompletion @relation(fields: [workoutCompletionId], references: [id], onDelete: Cascade)
  programExerciseId   String
  programExercise     ProgramExercise   @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  setNumber           Int
  actualReps          Int?
  actualWeight        Float?
  completed           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([workoutCompletionId, programExerciseId, setNumber])
  @@index([workoutCompletionId])
  @@index([programExerciseId])
}

model Conversation {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachConversations", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([clientId, coachId])
  @@index([clientId])
  @@index([coachId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model CheckIn {
  id                String        @id @default(cuid())
  clientProfileId   String
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  weekStart         DateTime
  workoutsCompleted Int?
  energyLevel       Int?
  sleepQuality      Int?
  currentWeight     Float?
  submittedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  response CheckInResponse?

  @@index([clientProfileId])
  @@index([weekStart])
}

model CheckInResponse {
  id        String   @id @default(cuid())
  checkInId String   @unique
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  feedback  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
}

model ProgressLog {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  coachId         String?
  coach           User?         @relation(fields: [coachId], references: [id], onDelete: SetNull)

  type        ProgressLogType @default(PROGRESS_PHOTO)
  title       String?
  description String?

  weight  Float?
  bodyFat Float?
  waist   Float?
  chest   Float?
  hips    Float?
  hipCm   Float?
  gluteCm Float?
  thighCm Float?
  notes   String?

  mediaId String?
  media   Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  photos  ProgressPhoto[]

  coachComment String?
  coachRating  Int?
  commentedAt  DateTime?

  visibility MediaVisibility @default(COACH_ONLY)
  loggedAt   DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([clientProfileId])
  @@index([coachId])
  @@index([type])
  @@index([loggedAt])
}

model ProgressPhoto {
  id      String      @id @default(cuid())
  logId   String
  log     ProgressLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  view    PhotoView

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([logId, mediaId])
  @@index([logId])
  @@index([mediaId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(trialing)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  approvedById         String?
  approvedBy           User?              @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

model Payment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripePaymentId String       @unique
  amount          Int
  currency        String       @default("usd")
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([subscriptionId])
}

model PaymentRequest {
  id                String               @id @default(cuid())
  clientUserId      String
  clientUser        User                 @relation("PaymentRequestClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  coachUserId       String?
  coachUser         User?                @relation("PaymentRequestCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  plan              SubscriptionPlan
  amount            Int
  currency          String               @default("USD")
  paymentMethod     String
  transactionRef    String?
  proofUrl          String
  proofFileName     String?
  notes             String?
  status            PaymentRequestStatus @default(PENDING)
  reviewNote        String?
  reviewedById      String?
  reviewedBy        User?                @relation("PaymentRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  auditLogs         PaymentRequestAuditLog[]

  @@index([clientUserId])
  @@index([coachUserId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRequestAuditLog {
  id               String        @id @default(cuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  action           String
  performedById    String
  performedBy      User          @relation("AuditLogPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  note             String?
  createdAt        DateTime      @default(now())

  @@index([paymentRequestId])
  @@index([performedById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Media {
  id           String    @id @default(cuid())
  title        String
  description  String?
  type         MediaType
  url          String
  thumbnailUrl String?
  fileSize     Int
  mimeType     String
  duration     Int?
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  programId    String?
  program      Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  weekId       String?
  week         ProgramWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)
  programDayId String?
  programDay   ProgramDay?  @relation(fields: [programDayId], references: [id], onDelete: SetNull)

  tags           MediaTag[]
  progressLogs   ProgressLog[]
  progressPhotos ProgressPhoto[]

  visibility MediaVisibility @default(COACH_ONLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([uploadedById])
  @@index([programId])
}

model MediaTag {
  id      String @id @default(cuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     String

  @@unique([mediaId, tag])
  @@index([tag])
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("NOMICA")
  siteDescription String?  @default("Premium Feminine Transformation Fitness")
  contactEmail    String?
  contactPhone    String?
  address         String?
  logoUrl         String?
  faviconUrl      String?
  instagramUrl    String?
  tiktokUrl       String?
  youtubeUrl      String?
  twitterUrl      String?
  facebookUrl     String?
  heroTagline     String?  @default("Stop Scrolling. Start Sculpting.")
  heroSubtext     String?
  updatedAt       DateTime @updatedAt
}

model LandingContent {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String?
  subtitle  String?
  content   Json?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@index([order])
}

enum HabitType {
  WATER
  SLEEP
  PROTEIN
  STRETCHING
  STEPS
  VITAMINS
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      HabitType
  target    Int        @default(1)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  logs HabitLog[]

  @@unique([userId, type])
  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  targetValue Float?
  currentValue Float?
  unit        String?
  status      GoalStatus @default(ACTIVE)
  deadline    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

enum FavoriteType {
  EXERCISE
  PROGRAM
  RECIPE
  ARTICLE
}

model Favorite {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FavoriteType
  targetId  String
  createdAt DateTime    @default(now())

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([type])
}

model FreeTrial {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("FreeTrialRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedById  String
  grantedBy    User            @relation("FreeTrialGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  durationDays Int
  startDate    DateTime        @default(now())
  endDate      DateTime
  status       FreeTrialStatus @default(ACTIVE)
  reason       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([grantedById])
  @@index([status])
  @@index([endDate])
}
